# Server Configuration
# The port on which the Go server will listen
SERVER_PORT=8080

# Security
# A strong, random string used to sign JWT tokens. 
# You can generate one using: openssl rand -base64 32
JWT_SECRET="change_me_to_a_secure_random_string"

# Database Connection
# Format: postgres://user:password@host:port/dbname?sslmode=disable
# Note: If running via Docker Compose with port mapping 5433:5432, use port 5433 here.
DATABASE_URL="postgres://secureshare_user:secureshare_pass@localhost:5433/secureshare_db?sslmode=disable"

# AWS S3 Configuration (IAM User: secureshare-go-api)
# These credentials must have s3:PutObject and s3:GetObject permissions
AWS_ACCESS_KEY_ID="AKIA_REPLACE_WITH_YOUR_KEY"
AWS_SECRET_ACCESS_KEY="replace_with_your_secret_access_key"
AWS_BUCKET_NAME="your-unique-bucket-name"
AWS_REGION="us-east-1"